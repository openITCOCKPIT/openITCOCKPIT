{
    "name": "openitcockpit/openitcockpit",
    "description": "openITCOCKPIT is an open source monitoring framework based on nagios",
    "homepage": "https://openitcockpit.io/",
    "license": "Dual licensed GPLv3 and proprietary",
    "authors": [
        {
            "name": "AVENDIS GmbH",
            "role": "Developer"
        }
    ],
    "type": "project",
    "support": {
        "issues": "https://github.com/openITCOCKPIT/openITCOCKPIT/issues",
        "source": "https://github.com/openITCOCKPIT/openITCOCKPIT",
        "irc": "irc://irc.libera.chat/openitcockpit",
        "docs": "https://docs.openitcockpit.io/"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/openITCOCKPIT/acl"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-calendar": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-gearman": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "ext-simplexml": "*",
        "ext-soap": "*",
        "ext-sockets": "*",
        "ext-sysvsem": "*",
        "ext-xmlrpc": "*",
        "ext-zip": "*",
        "azuyalabs/yasumi": "^2.12",
        "cakephp/authentication": "^4.0",
        "cakephp/authorization": "^3.0",
        "cakephp/cakephp": "~5.4.0",
        "cakephp/migrations": "^5.2",
        "cakephp/plugin-installer": "^2.0",
        "chillerlan/php-qrcode": "^3.4.1 || ^4.3.3",
        "corsinvest/cv4pve-api-php": "^9.2",
        "damienharper/adf-tools": "^1.1",
        "erusev/parsedown": "^1.8",
        "erusev/parsedown-extra": "^0.9.0",
        "freedsx/ldap": "^0.9",
        "friendsofcake/cakephp-csvview": "^5.0",
        "guzzlehttp/guzzle": "^7.4",
        "itnovum/acl": "dev-5.x-dev",
        "jbbcode/jbbcode": "^1.4",
        "jdorn/sql-formatter": "^1.2",
        "lasserafn/php-initial-avatar-generator": "^4.2",
        "league/oauth2-client": "^2.5",
        "matthiasmullie/minify": "^1.3.76",
        "microsoft/microsoft-graph": "^1.92",
        "mobiledetect/mobiledetectlib": "4.*",
        "nickbeen/php-cli-progress-bar": "^1.2.0",
        "phpoffice/phpspreadsheet": "^5.10.0",
        "promphp/prometheus_client_php": "^v2.15.1",
        "spatie/emoji": "^4.2",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/yaml": "^7.4",
        "tecnickcom/tc-lib-pdf": "^8.83",
        "telegram-bot/api": "^2.5",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "cakephp/bake": "^3.0",
        "cakephp/cakephp-codesniffer": "^5.0",
        "cakephp/debug_kit": "^5.0",
        "cakephp/migrations": "^5.2",
        "josegonzalez/dotenv": "4.*",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.1",
        "psy/psysh": "@stable"
    },
    "suggest": {
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification.",
        "dereuromark/cakephp-ide-helper": "After baking your code, this keeps your annotations in sync with the code evolving from there on for maximum IDE and PHPStan/Psalm compatibility."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "itnovum\\openITCOCKPIT\\": "src/itnovum/openITCOCKPIT/",
            "Statusengine\\": "src/Statusengine/",
            "TelegramBot\\Api\\": "vendor/telegram-bot/api/src/"
        },
        "files": [
            "src/3rd/imageSmoothArc.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        },
        "files": [
            "src/3rd/imageSmoothArc.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "App\\Console\\Installer::postInstall",
            "@tc-lib-pdf-fonts"
        ],
        "post-update-cmd": [
            "@tc-lib-pdf-fonts"
        ],
        "post-create-project-cmd": "App\\Console\\Installer::postInstall",
        "tc-lib-pdf-fonts": "@php vendor/tecnickcom/tc-lib-pdf-font/util/build_fonts.php",
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/ tests/",
        "cs-fix": "phpcbf --colors --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/ tests/",
        "stan": "phpstan analyse src/",
        "stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan-shim:^0.11 && mv composer.backup composer.json",
        "test": "phpunit --colors=always"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "github-protocols": [
            "https"
        ],
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        }
    }
}

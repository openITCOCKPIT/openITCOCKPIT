[Unit]
Description=openITCOCKPIT WebSocket Background Service
After=syslog.target network.target mysql.service

[Service]
User=www-data
Group=nagios
Type=simple
Restart=on-failure
ExecStart=/opt/openitc/websocket/websocket
LimitNOFILE=10000
LimitNOFILESoft=10000
RestartSec=30

[Install]
WantedBy=multi-user.target
